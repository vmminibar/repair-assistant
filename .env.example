# --- Required ---
# MySQL connection string (create the database in Hostinger hPanel > Databases)
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME

# Anthropic API key (https://console.anthropic.com). Server-side only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Web search provider: "brave" or "tavily"
SEARCH_PROVIDER=brave
# Brave Search API key (https://brave.com/search/api/) if SEARCH_PROVIDER=brave
BRAVE_API_KEY=
# Tavily API key (https://tavily.com) if SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# --- Optional ---
# Requests per minute per IP for /api/diagnose and /api/vision
RATE_LIMIT_PER_MINUTE=10
